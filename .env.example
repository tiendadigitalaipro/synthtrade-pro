# ============================================
# SYNTHTRADE PRO - Configuración
# ============================================
# Copia este archivo como .env y ajusta los valores

# ─── Base de Datos ───────────────────────────
# Para Windows (usa barras dobles o barra simple):
DATABASE_URL=file:./db/custom.db
# Para Mac/Linux:
# DATABASE_URL=file:./db/custom.db

# ─── Iron Lock — Sistema de Licencias ────────
# ⚠️ OBLIGATORIO: Clave maestra del panel de administración de licencias
# NO USAR POR DEFECTO. Genera una clave segura con: openssl rand -hex 32
# Sin esta variable, la API de licencias responderá con error 503.
IRON_LOCK_ADMIN_KEY=
